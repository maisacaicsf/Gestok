rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Resolver mínimo para o login Código da Loja + Usuário.
    // Contém apenas identificadores de acesso e o e-mail técnico do Firebase Auth.
    match /acessos/{chave} {
      allow get: if true;
      allow list: if false;

      // Só cria o índice de acesso quem é dono da loja informada, e a chave
      // precisa ser exatamente "codigoLoja_usuario" (impede ocupar chaves alheias).
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && chave == request.resource.data.codigoLoja + '_' + request.resource.data.usuario
        && get(/databases/$(database)/documents/lojas/$(request.resource.data.lojaId)).data.donoUid == request.auth.uid;

      // O dono pode atualizar, mas não pode trocar a loja nem o uid vinculados.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.lojaId == resource.data.lojaId;

      allow delete: if false;
    }

    match /lojas/{lojaId} {

      // Na criação, a loja só pode nascer com TESTE GRÁTIS (no máximo ~45 dias,
      // com folga para diferença de relógio). Assinatura "ativa" só o servidor
      // (Cloud Functions / Admin SDK) consegue gravar.
      allow create: if request.auth != null
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.assinatura.status == 'teste_gratis'
        && request.resource.data.assinatura.pagamento == 'gratis'
        && request.resource.data.assinatura.vencimento <= request.time + duration.value(45, 'd');

      allow read: if request.auth != null
        && resource.data.donoUid == request.auth.uid;

      // O dono pode editar a loja, MAS NÃO os campos de assinatura, dono e código.
      allow update: if request.auth != null
        && resource.data.donoUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['assinatura', 'donoUid', 'codigo']);

      allow delete: if false;

      match /usuarios/{uid} {
        allow create: if request.auth != null
          && uid == request.auth.uid
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;

        allow read, update: if request.auth != null
          && uid == request.auth.uid
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;

        allow delete: if false;
      }

      // Operadores do PDV: somente o proprietário da loja pode criar, consultar, alterar ou desativar.
      match /operadores/{operadorId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
      }

      match /produtos/{produtoId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
      }

      match /movimentacoes/{movimentoId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
      }

      match /chamados/{chamadoId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
      }

      match /solicitacoes/{solicitacaoId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
      }
    }
  }
}
